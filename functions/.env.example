# Local dev / emulator: loaded via dotenv. Do not duplicate this name as a Firebase secret (deploy conflict).
ENCRYPTION_KEY=
#
# Production: store the same base64 value as Secret `IPTV_ENCRYPTION_KEY`:
#   firebase functions:secrets:set IPTV_ENCRYPTION_KEY --data-file=...
# (bound in code to upsertSource, refreshPlaylist, scheduledPlaylistRefresh).

# Optional — enables TMDB title/overview append when playlist has enrichEnabled.
TMDB_API_KEY=
