VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# When developing against the Firebase emulator suite:
VITE_USE_EMULATOR=true

# Optional: exact URL Firebase redirects to after email link (must be an authorized domain).
# If unset, the app uses the current page origin (works for localhost and your Hosting URL).
# VITE_EMAIL_LINK_CONTINUE_URL=https://your-project.web.app/
